:root {
    --background: #0b1118;
    --background-soft: #111a24;
    --panel: #151f2b;
    --text: #edf2f7;
    --muted: #9eabb9;
    --accent: #55c2d8;
    --accent-light: #83d8e8;
    --border: #263443;
    --max-width: 1180px;
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

    background: var(--background);
    color: var(--text);
    line-height: 1.65;
}

a {
    color: inherit;
    text-decoration: none;
}

.container {
    width: min(90%, var(--max-width));
    margin: auto;
}

.narrow {
    max-width: 850px;
}

.site-header {
    position: sticky;
    top: 0;
    z-index: 100;

    background: rgba(11, 17, 24, 0.94);
    border-bottom: 1px solid var(--border);
}

.nav-container {
    min-height: 72px;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

.brand {
    font-weight: 800;
    letter-spacing: .08em;
}

.brand span {
    color: var(--accent);
}

nav {
    display: flex;
    gap: 32px;
}

nav a {
    color: var(--muted);
    font-size: .92rem;
}

nav a:hover {
    color: var(--accent);
}

.hero {
    min-height: calc(100vh - 72px);

    display: flex;
    align-items: center;

    background:
        radial-gradient(
            circle at 80% 20%,
            rgba(85, 194, 216, .12),
            transparent 32%
        );
}

.hero-content {
    padding: 100px 0 80px;
}

.eyebrow,
.section-label,
.project-type {
    color: var(--accent);
    font-weight: 700;
    letter-spacing: .16em;
    font-size: .78rem;
}

.hero h1 {
    max-width: 950px;

    margin: 20px 0;

    font-size: clamp(3.1rem, 7vw, 6.6rem);
    line-height: .98;
    letter-spacing: -.055em;
}

.hero-description {
    max-width: 720px;

    color: var(--muted);

    font-size: 1.25rem;
}

.hero-actions {
    display: flex;
    gap: 14px;

    margin-top: 36px;
}

.button {
    display: inline-block;

    padding: 13px 22px;

    border: 1px solid var(--border);
    border-radius: 5px;

    font-weight: 650;
}

.button.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #071015;
}

.button.secondary:hover {
    border-color: var(--accent);
}

.hero-domains {
    margin-top: 90px;

    display: grid;
    grid-template-columns: repeat(4, 1fr);

    border-top: 1px solid var(--border);
}

.hero-domains div {
    padding: 25px 25px 0 0;
}

.hero-domains strong,
.hero-domains span {
    display: block;
}

.hero-domains span {
    margin-top: 4px;

    color: var(--muted);
    font-size: .87rem;
}

.section {
    padding: 120px 0;
}

.section.alt {
    background: var(--background-soft);
}

.section h2 {
    margin: 10px 0 25px;

    max-width: 850px;

    font-size: clamp(2.2rem, 4vw, 4rem);
    line-height: 1.08;
    letter-spacing: -.035em;
}

.lead,
.section-intro {
    color: var(--muted);
    font-size: 1.2rem;
}

.card-grid,
.project-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);

    gap: 20px;

    margin-top: 50px;
}

.card,
.project-card {
    padding: 35px;

    background: var(--panel);

    border: 1px solid var(--border);
    border-radius: 7px;

    transition:
        transform .2s ease,
        border-color .2s ease;
}

.card:hover,
.project-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
}

.card-number {
    color: var(--accent);
    font-family: monospace;
}

.card h3,
.project-card h3 {
    margin-bottom: 10px;
    font-size: 1.4rem;
}

.card p,
.project-card p {
    color: var(--muted);
}

.project-type {
    margin-bottom: 30px;
}

.tags {
    display: flex;
    flex-wrap: wrap;

    gap: 8px;

    margin-top: 25px;
}

.tags span {
    padding: 5px 10px;

    border: 1px solid var(--border);
    border-radius: 4px;

    color: var(--muted);

    font-size: .78rem;
}

.technology-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);

    gap: 50px;

    margin-top: 50px;
}

.technology-grid h3 {
    color: var(--accent-light);
}

.technology-grid p {
    color: var(--muted);
}

.closing h2 {
    font-size: clamp(2.6rem, 5vw, 5rem);
}

footer {
    padding: 40px 0;

    border-top: 1px solid var(--border);

    color: var(--muted);
}

.footer-content {
    display: flex;
    justify-content: space-between;
}

.footer-content p {
    margin: 4px 0;
}

@media (max-width: 800px) {

    nav {
        display: none;
    }

    .hero-content {
        padding-top: 70px;
    }

    .hero-domains,
    .card-grid,
    .project-grid,
    .technology-grid {
        grid-template-columns: 1fr;
    }

    .hero-domains {
        margin-top: 60px;
    }

    .section {
        padding: 80px 0;
    }

    .footer-content {
        flex-direction: column;
        gap: 20px;
    }
}


/* =========================================
   INTERIOR PAGES
   ========================================= */

.page-hero {
    padding: 130px 0 90px;

    background:
        radial-gradient(
            circle at 80% 20%,
            rgba(85, 194, 216, .10),
            transparent 32%
        );

    border-bottom: 1px solid var(--border);
}

.page-hero h1 {
    margin: 15px 0 25px;

    font-size: clamp(3.2rem, 7vw, 6rem);
    line-height: 1;
    letter-spacing: -.05em;
}

.service-title {
    margin: 30px 0;
    padding: 25px 0;

    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
}

.service-title h3 {
    margin: 0 0 8px;
    font-size: 1.4rem;
}

.service-title p {
    margin: 3px 0;
    color: var(--muted);
}

.timeline {
    margin-top: 55px;
}

.timeline-item {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 40px;

    padding: 35px 0;

    border-top: 1px solid var(--border);
}

.timeline-date {
    color: var(--accent);

    font-family: monospace;
    font-size: 1rem;
    font-weight: 700;
}

.timeline-item h3 {
    margin-top: 0;
}

.timeline-item p {
    color: var(--muted);
}

.recognition-card h3 {
    min-height: 60px;
}

@media (max-width: 800px) {

    .page-hero {
        padding: 90px 0 65px;
    }

    .timeline-item {
        grid-template-columns: 1fr;
        gap: 8px;
    }

}


/* =========================================
   CAREER / EXPERIENCE
   ========================================= */

.career-timeline {
    margin-top: 70px;
}

.career-entry {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 55px;

    padding: 55px 0;

    border-top: 1px solid var(--border);
}

.career-year {
    display: flex;
    flex-direction: column;

    color: var(--accent);

    font-family: monospace;
    font-size: 1.25rem;
    font-weight: 700;
}

.career-year-end {
    margin-top: 4px;
    color: var(--muted);
}

.career-type {
    margin: 0 0 12px;

    color: var(--accent);

    font-family: monospace;
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .12em;
}

.career-content h3 {
    margin: 0 0 8px;

    font-size: clamp(1.6rem, 3vw, 2.4rem);
}

.career-subtitle {
    margin: 0 0 25px;

    color: var(--muted);
    font-weight: 600;
}

.career-content > p:not(.career-type):not(.career-subtitle) {
    max-width: 850px;

    color: var(--muted);
    line-height: 1.8;
}

.career-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;

    margin-top: 22px;
}

.career-tags span {
    padding: 6px 10px;

    border: 1px solid var(--border);
    border-radius: 4px;

    color: var(--muted);

    font-family: monospace;
    font-size: .72rem;
}

.education-entry {
    background: rgba(255,255,255,.015);
}

.featured-career {
    position: relative;
}

.featured-career::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: -25px;

    width: 2px;

    background: var(--accent);

    content: "";
}

.text-link {
    display: inline-block;
    margin-top: 25px;

    color: var(--accent);

    font-weight: 700;
    text-decoration: none;
}


/* Enterprise initiatives */

.initiative-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;

    margin-top: 50px;
}

.initiative-card {
    padding: 30px;

    border: 1px solid var(--border);

    background: rgba(255,255,255,.015);
}

.initiative-year {
    color: var(--accent);

    font-family: monospace;
    font-size: .75rem;
    font-weight: 700;
}

.initiative-card h3 {
    margin: 12px 0 15px;

    font-size: 1.3rem;
}

.initiative-card > p {
    color: var(--muted);
    line-height: 1.7;
}


/* Career evolution */

.evolution-path {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-top: 60px;
    padding: 35px;

    border: 1px solid var(--border);
}

.evolution-path > div:not(.evolution-arrow) {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.evolution-path span {
    color: var(--accent);

    font-family: monospace;
    font-size: .7rem;
}

.evolution-path strong {
    font-size: .95rem;
}

.evolution-path small {
    color: var(--muted);
}

.evolution-arrow {
    color: var(--accent);
    opacity: .5;
}

.methodology-statement {
    max-width: 850px;

    margin: 65px auto 0;

    text-align: center;
}

.methodology-statement p {
    font-size: clamp(1.3rem, 2.5vw, 2rem);
    font-weight: 600;
    line-height: 1.65;
}


/* Experience responsive */

@media (max-width: 900px) {

    .career-entry {
        grid-template-columns: 1fr;
        gap: 15px;
    }

    .career-year {
        flex-direction: row;
        gap: 8px;
    }

    .career-year-end {
        margin-top: 0;
    }

    .initiative-grid {
        grid-template-columns: 1fr;
    }

    .evolution-path {
        flex-direction: column;
        align-items: flex-start;
        gap: 18px;
    }

    .evolution-arrow {
        transform: rotate(90deg);
    }

}


/* =========================================
   PROJECT PORTFOLIO
   ========================================= */

.project-catalog {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;

    margin-top: 55px;
}

.portfolio-project {
    padding: 35px;

    border: 1px solid var(--border);

    background: rgba(255,255,255,.015);
}

.portfolio-project h3 {
    margin: 15px 0 5px;

    font-size: clamp(1.5rem, 2.5vw, 2rem);
}

.portfolio-project > p {
    color: var(--muted);
    line-height: 1.75;
}

.project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.project-meta span {
    color: var(--accent);

    font-family: monospace;
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .08em;
}

.project-meta span + span::before {
    margin-right: 8px;
    color: var(--muted);
    content: "•";
}

.project-domain {
    margin-top: 5px !important;
    margin-bottom: 22px !important;

    font-size: .85rem;
    font-weight: 600;
}

.featured-project {
    position: relative;
}

.featured-project::after {
    position: absolute;
    top: -1px;
    right: 25px;

    width: 45px;
    height: 2px;

    background: var(--accent);

    content: "";
}


/* Project inventory */

.project-inventory {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;

    margin-top: 50px;

    background: var(--border);
    border: 1px solid var(--border);
}

.inventory-group {
    min-height: 210px;
    padding: 28px;

    background: var(--bg);
}

.inventory-category {
    margin: 0;

    color: var(--accent);

    font-family: monospace;
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .1em;
}

.inventory-group h3 {
    margin: 12px 0;

    font-size: 1.25rem;
}

.inventory-group > p:last-child {
    color: var(--muted);
    line-height: 1.65;
}


@media (max-width: 900px) {

    .project-catalog {
        grid-template-columns: 1fr;
    }

    .project-inventory {
        grid-template-columns: 1fr;
    }

}


/* =========================================
   TRAINING
   ========================================= */

.training-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;

    margin-top: 55px;
}

.training-card {
    padding: 35px;

    border: 1px solid var(--border);

    background: rgba(255,255,255,.015);
}

.training-year {
    color: var(--accent);

    font-family: monospace;
    font-size: 1.1rem;
    font-weight: 700;
}

.training-provider {
    margin: 8px 0 12px;

    color: var(--muted);

    font-family: monospace;
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .1em;
}

.training-card h3 {
    margin: 12px 0 20px;

    font-size: 1.35rem;
    line-height: 1.35;
}

.training-card > p {
    color: var(--muted);
    line-height: 1.75;
}


/* Training timeline */

.training-timeline {
    margin-top: 55px;
}

.training-timeline-item {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 45px;

    padding: 38px 0;

    border-top: 1px solid var(--border);
}

.training-timeline-date {
    color: var(--accent);

    font-family: monospace;
    font-size: 1rem;
    font-weight: 700;
}

.training-timeline-content {
    max-width: 850px;
}

.training-timeline-content h3 {
    margin: 5px 0 15px;

    font-size: 1.4rem;
}

.training-timeline-content > p:last-child {
    color: var(--muted);
    line-height: 1.75;
}


/* Progression */

.training-progression {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1px;

    margin-top: 55px;

    background: var(--border);
    border: 1px solid var(--border);
}

.training-progression > div {
    min-height: 180px;
    padding: 25px;

    background: var(--bg);
}

.training-progression span {
    display: block;

    margin-bottom: 12px;

    color: var(--accent);

    font-family: monospace;
    font-size: .65rem;
    font-weight: 700;
    letter-spacing: .08em;
}

.training-progression strong {
    display: block;

    margin-bottom: 10px;

    font-size: 1rem;
}

.training-progression p {
    color: var(--muted);
    font-size: .82rem;
    line-height: 1.6;
}


@media (max-width: 900px) {

    .training-grid {
        grid-template-columns: 1fr;
    }

    .training-timeline-item {
        grid-template-columns: 1fr;
        gap: 8px;
    }

    .training-progression {
        grid-template-columns: 1fr;
    }

}


/* =========================================
   SKILLS
   ========================================= */

.skill-domain-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 55px;
}

.skill-domain {
    padding: 35px;
    border: 1px solid var(--border);
    background: rgba(255,255,255,.015);
}

.skill-domain-number {
    color: var(--accent);
    font-family: monospace;
    font-size: .75rem;
    font-weight: 700;
}

.skill-domain h3 {
    margin: 10px 0 18px;
    font-size: 1.5rem;
}

.skill-domain > p {
    color: var(--muted);
    line-height: 1.7;
}

.skill-subheading {
    margin: 30px 0 10px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);

    color: var(--accent);
    font-family: monospace;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
}

.skill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 20px 0;
}

.skill-list span {
    padding: 6px 9px;
    border: 1px solid var(--border);
    border-radius: 3px;

    color: var(--muted);
    font-family: monospace;
    font-size: .7rem;
}

.skill-evidence {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
}

.skill-evidence strong {
    color: var(--accent);
    font-family: monospace;
    font-size: .7rem;
    letter-spacing: .07em;
    text-transform: uppercase;
}

.skill-evidence p {
    margin-bottom: 0;
    color: var(--muted);
    font-size: .85rem;
    line-height: 1.65;
}

.security-domain {
    grid-column: span 2;
}


/* CAPABILITY FLOW */

.capability-flow {
    display: flex;
    align-items: stretch;
    margin-top: 55px;
    border: 1px solid var(--border);
}

.capability-flow > div:not(.capability-arrow) {
    flex: 1;
    padding: 28px 20px;
}

.capability-flow small {
    display: block;
    margin-bottom: 8px;

    color: var(--accent);
    font-family: monospace;
    font-size: .62rem;
    font-weight: 700;
    letter-spacing: .08em;
}

.capability-flow strong {
    display: block;
    margin-bottom: 8px;
    font-size: 1.1rem;
}

.capability-flow p {
    margin: 0;
    color: var(--muted);
    font-size: .8rem;
    line-height: 1.5;
}

.capability-arrow {
    display: flex;
    align-items: center;
    color: var(--accent);
    opacity: .45;
}


@media (max-width: 900px) {

    .skill-domain-grid {
        grid-template-columns: 1fr;
    }

    .security-domain {
        grid-column: span 1;
    }

    .capability-flow {
        flex-direction: column;
    }

    .capability-arrow {
        padding-left: 20px;
        transform: rotate(90deg);
    }

}


/* =========================================
   SKILL EVIDENCE
   ========================================= */

.evidence-section {
    margin-top: 35px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
}

.evidence-title {
    margin: 0 0 20px;

    color: var(--accent);
    font-family: monospace;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .09em;
    text-transform: uppercase;
}

.evidence-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
}

.evidence-card {
    padding: 20px;
    border: 1px solid var(--border);
    background: rgba(255,255,255,.018);
}

.evidence-card h4 {
    margin: 0 0 10px;
    font-size: .95rem;
}

.evidence-card p {
    margin: 0;
    color: var(--muted);
    font-size: .8rem;
    line-height: 1.65;
}

.related-work {
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px dashed var(--border);
}

.related-work strong {
    display: block;
    margin-bottom: 9px;

    color: var(--muted);
    font-family: monospace;
    font-size: .68rem;
    letter-spacing: .07em;
    text-transform: uppercase;
}

.related-work p {
    margin: 0;
    color: var(--accent);
    font-size: .8rem;
    line-height: 1.7;
}

@media (max-width: 700px) {
    .evidence-grid {
        grid-template-columns: 1fr;
    }
}


/* =========================================
   ABOUT
   ========================================= */

.about-layout {
    display: grid;
    grid-template-columns: .8fr 1.2fr;
    gap: 80px;
    align-items: start;
}

.about-copy {
    max-width: 760px;
}

.about-copy p {
    color: var(--muted);
    line-height: 1.85;
}

.about-copy .about-lead {
    color: var(--text);
    font-size: 1.15rem;
    line-height: 1.75;
}


/* CAREER EVOLUTION */

.career-evolution {
    display: flex;
    align-items: stretch;
    margin-top: 55px;
}

.evolution-step {
    flex: 1;
    min-width: 0;
    padding: 25px 20px;
    border: 1px solid var(--border);
}

.evolution-step > span {
    color: var(--accent);
    font-family: monospace;
    font-size: .7rem;
}

.evolution-step small {
    display: block;
    margin: 12px 0 8px;

    color: var(--muted);
    font-family: monospace;
    font-size: .62rem;
    letter-spacing: .08em;
}

.evolution-step h3 {
    margin: 0 0 12px;
    font-size: 1rem;
}

.evolution-step p {
    margin: 0;
    color: var(--muted);
    font-size: .78rem;
    line-height: 1.6;
}

.evolution-arrow {
    display: flex;
    align-items: center;
    padding: 8px;

    color: var(--accent);
    opacity: .45;
}


/* METHOD */

.method-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
    margin-top: 50px;
}

.method-card {
    padding: 28px;
    border: 1px solid var(--border);
}

.method-card span {
    color: var(--accent);
    font-family: monospace;
    font-size: .7rem;
}

.method-card h3 {
    margin: 12px 0;
}

.method-card p {
    margin: 0;
    color: var(--muted);
    font-size: .85rem;
    line-height: 1.65;
}


/* CURRENT FOCUS */

.focus-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
    margin-top: 50px;
}

.focus-card {
    display: flex;
    flex-direction: column;
    padding: 28px;
    min-height: 245px;

    border: 1px solid var(--border);
}

.focus-card > span {
    color: var(--accent);
    font-family: monospace;
    font-size: .7rem;
}

.focus-card h3 {
    margin: 12px 0;
}

.focus-card p {
    flex: 1;
    color: var(--muted);
    font-size: .85rem;
    line-height: 1.65;
}

.focus-card a {
    margin-top: 18px;

    color: var(--accent);
    font-family: monospace;
    font-size: .72rem;
    text-decoration: none;
}


/* CLOSING */

.about-closing {
    text-align: center;
}

.about-closing > p {
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;

    color: var(--muted);
    line-height: 1.8;
}

.about-links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 25px;

    margin-top: 35px;
}

.about-links a {
    color: var(--accent);
    font-family: monospace;
    font-size: .75rem;
    text-decoration: none;
}


@media (max-width: 950px) {

    .about-layout {
        grid-template-columns: 1fr;
        gap: 30px;
    }

    .career-evolution {
        flex-direction: column;
    }

    .evolution-arrow {
        transform: rotate(90deg);
        align-self: flex-start;
        margin-left: 20px;
    }

    .method-grid,
    .focus-grid {
        grid-template-columns: 1fr 1fr;
    }

}


@media (max-width: 650px) {

    .method-grid,
    .focus-grid {
        grid-template-columns: 1fr;
    }

}


/* =========================================
   RESUME
   ========================================= */

.resume-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 30px;
}

.resume-actions a,
.resume-more a,
.resume-body a {
    color: var(--accent);
    font-family: monospace;
    font-size: .75rem;
    text-decoration: none;
}

.resume-container {
    display: grid;
    grid-template-columns: .65fr 1.35fr;
    gap: 70px;
}

.resume-body {
    max-width: 800px;
}

.resume-body p,
.resume-body li {
    color: var(--muted);
    line-height: 1.75;
}

.resume-lead {
    color: var(--text) !important;
    font-size: 1.05rem;
}

.resume-capabilities {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 35px;
}

.resume-capabilities span {
    padding: 8px 11px;
    border: 1px solid var(--border);

    color: var(--muted);
    font-family: monospace;
    font-size: .7rem;
}

.resume-job {
    display: grid;
    grid-template-columns: 190px 1fr;
    gap: 40px;

    padding: 38px 0;
    border-bottom: 1px solid var(--border);
}

.resume-job-meta span,
.resume-date {
    color: var(--accent);
    font-family: monospace;
    font-size: .7rem;
    letter-spacing: .05em;
}

.resume-job-content h3 {
    margin: 0 0 5px;
    font-size: 1.3rem;
}

.resume-company,
.resume-subtitle {
    color: var(--muted);
    font-weight: 600;
}

.resume-job-content > p,
.resume-job-content li {
    color: var(--muted);
    line-height: 1.65;
}

.resume-job-content ul,
.resume-body ul {
    padding-left: 20px;
}

.resume-project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
    margin-top: 45px;
}

.resume-project {
    padding: 25px;
    border: 1px solid var(--border);
}

.resume-project > span {
    color: var(--accent);
    font-family: monospace;
    font-size: .62rem;
    letter-spacing: .07em;
}

.resume-project h3 {
    margin: 10px 0;
    font-size: 1rem;
}

.resume-project p {
    margin: 0;
    color: var(--muted);
    font-size: .8rem;
    line-height: 1.6;
}

.resume-more {
    margin-top: 30px;
}

.resume-awards {
    margin: 30px 0;
    padding: 20px;
    border-left: 2px solid var(--accent);
}

.resume-awards strong {
    font-family: monospace;
    font-size: .72rem;
    color: var(--accent);
    text-transform: uppercase;
}

.resume-awards p {
    margin-bottom: 0;
}

.resume-two-column {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
}

.resume-training p {
    color: var(--muted);
    line-height: 1.6;
}

.resume-tech {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
    margin-top: 40px;
}

.resume-tech > div {
    padding: 22px;
    border: 1px solid var(--border);
}

.resume-tech strong {
    color: var(--accent);
    font-family: monospace;
    font-size: .72rem;
    text-transform: uppercase;
}

.resume-tech p {
    margin-bottom: 0;
    color: var(--muted);
    font-size: .8rem;
    line-height: 1.65;
}


@media (max-width: 900px) {

    .resume-container,
    .resume-two-column {
        grid-template-columns: 1fr;
        gap: 30px;
    }

    .resume-project-grid {
        grid-template-columns: 1fr 1fr;
    }

}


@media (max-width: 650px) {

    .resume-job {
        grid-template-columns: 1fr;
        gap: 10px;
    }

    .resume-project-grid,
    .resume-tech {
        grid-template-columns: 1fr;
    }

}


/* =========================================
   PROJECT CATALOG
   ========================================= */

.project-principles {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-top: 45px;
}

.project-principles > div {
    padding: 22px;
    border: 1px solid var(--border);
}

.project-principles strong {
    display: block;
    margin-bottom: 8px;
    color: var(--accent);
    font-family: monospace;
    font-size: .72rem;
    text-transform: uppercase;
}

.project-principles p {
    margin: 0;
    color: var(--muted);
    font-size: .8rem;
    line-height: 1.6;
}


.project-catalog-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 15px;
    margin-top: 45px;
}

.catalog-project {
    padding: 30px;
    border: 1px solid var(--border);
    background: rgba(255,255,255,.012);
}

.featured-project {
    min-height: 420px;
}

.project-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    flex-wrap: wrap;

    margin-bottom: 16px;

    color: var(--accent);
    font-family: monospace;
    font-size: .63rem;
    letter-spacing: .06em;
}

.project-status {
    padding: 4px 7px;
    border: 1px solid var(--border);
    color: var(--muted);
}

.catalog-project h3 {
    margin: 0 0 15px;
    font-size: 1.3rem;
}

.catalog-project > p,
.catalog-project li {
    color: var(--muted);
    font-size: .84rem;
    line-height: 1.65;
}

.catalog-project ul {
    padding-left: 18px;
}

.project-tech {
    margin-top: 22px;
    padding-top: 15px;
    border-top: 1px solid var(--border);

    color: var(--accent);
    font-family: monospace;
    font-size: .68rem;
    line-height: 1.7;
}

.compact-project-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
}

.compact-project-grid .catalog-project {
    min-height: 270px;
}


.case-study-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 35px;
}

.case-study-list span {
    padding: 8px 11px;
    border: 1px solid var(--border);

    color: var(--muted);
    font-family: monospace;
    font-size: .7rem;
}


@media (max-width: 950px) {

    .project-principles {
        grid-template-columns: 1fr 1fr;
    }

    .compact-project-grid {
        grid-template-columns: 1fr 1fr;
    }

}


@media (max-width: 700px) {

    .project-principles,
    .project-catalog-grid,
    .compact-project-grid {
        grid-template-columns: 1fr;
    }

    .featured-project,
    .compact-project-grid .catalog-project {
        min-height: auto;
    }

}


/* =========================================
   PROJECT CASE STUDIES
   ========================================= */

.case-hero {
    padding: 120px 0 85px;
    border-bottom: 1px solid var(--border);
}

.case-hero h1 {
    max-width: 1000px;
    margin: 14px 0 22px;
    font-size: clamp(3rem, 7vw, 6rem);
    line-height: .95;
}

.case-back {
    display: inline-block;
    margin-bottom: 45px;
    color: var(--muted);
    font-family: monospace;
    font-size: .72rem;
    text-decoration: none;
}

.case-back:hover {
    color: var(--accent);
}

.case-lead {
    max-width: 820px;
    color: var(--muted);
    font-size: 1.15rem;
    line-height: 1.8;
}

.case-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 35px;
}

.case-tech span {
    padding: 7px 10px;
    border: 1px solid var(--border);
    color: var(--accent);
    font-family: monospace;
    font-size: .68rem;
}

.case-container {
    max-width: 1180px;
}

.case-section-heading {
    max-width: 850px;
    margin-bottom: 42px;
}

.case-section-heading h2 {
    margin-top: 8px;
}

.case-two-column {
    display: grid;
    grid-template-columns: 1.4fr .8fr;
    gap: 70px;
    align-items: start;
}

.case-two-column p {
    color: var(--muted);
    line-height: 1.85;
}

.case-callout {
    padding: 28px;
    border-left: 2px solid var(--accent);
    background: rgba(255,255,255,.015);
}

.case-callout strong {
    color: var(--accent);
    font-family: monospace;
    font-size: .72rem;
    text-transform: uppercase;
}

.case-callout p {
    margin-bottom: 0;
}

.case-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
}

.case-card {
    padding: 27px;
    border: 1px solid var(--border);
}

.case-card > span {
    color: var(--accent);
    font-family: monospace;
    font-size: .66rem;
}

.case-card h3 {
    margin: 12px 0;
    font-size: 1.05rem;
}

.case-card p {
    margin-bottom: 0;
    color: var(--muted);
    font-size: .84rem;
    line-height: 1.7;
}

.architecture-flow {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr auto 1fr;
    gap: 12px;
    align-items: center;
    margin-top: 40px;
}

.architecture-flow > div {
    min-height: 145px;
    padding: 22px;
    border: 1px solid var(--border);
}

.architecture-flow > b {
    color: var(--accent);
}

.architecture-flow span,
.architecture-flow strong,
.architecture-flow small {
    display: block;
}

.architecture-flow span {
    margin-bottom: 20px;
    color: var(--accent);
    font-family: monospace;
    font-size: .65rem;
}

.architecture-flow small {
    margin-top: 7px;
    color: var(--muted);
    line-height: 1.5;
}

.architecture-note {
    max-width: 850px;
    margin-top: 35px;
    color: var(--muted);
    line-height: 1.8;
}

.workflow-list {
    border-top: 1px solid var(--border);
}

.workflow-step {
    display: grid;
    grid-template-columns: 70px 1fr;
    gap: 25px;
    padding: 25px 0;
    border-bottom: 1px solid var(--border);
}

.workflow-step > span {
    color: var(--accent);
    font-family: monospace;
    font-size: .7rem;
}

.workflow-step h3 {
    margin: 0 0 7px;
}

.workflow-step p {
    max-width: 800px;
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
}

.decision-list {
    border-top: 1px solid var(--border);
}

.decision-list > div {
    display: grid;
    grid-template-columns: .8fr 1.5fr;
    gap: 50px;
    padding: 30px 0;
    border-bottom: 1px solid var(--border);
}

.decision-list h3,
.decision-list p {
    margin: 0;
}

.decision-list p {
    color: var(--muted);
    line-height: 1.75;
}

.evidence-example {
    max-width: 900px;
    border: 1px solid var(--border);
}

.evidence-line,
.evidence-result {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 20px;
    padding: 18px 22px;
    border-bottom: 1px solid var(--border);
}

.evidence-example > div:last-child {
    border-bottom: 0;
}

.evidence-line span,
.evidence-result span {
    color: var(--accent);
    font-family: monospace;
    font-size: .65rem;
}

.evidence-line p,
.evidence-result p {
    margin: 0;
    color: var(--muted);
}

.evidence-result {
    background: rgba(255,255,255,.025);
}

.evidence-result p {
    color: inherit;
}

.case-note {
    max-width: 900px;
    margin-top: 12px;
    color: var(--muted);
    font-size: .72rem;
    font-style: italic;
}

.case-timeline {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
}

.case-timeline > div {
    padding: 28px;
    border-right: 1px solid var(--border);
}

.case-timeline > div:last-child {
    border-right: 0;
}

.case-timeline span {
    color: var(--accent);
    font-family: monospace;
    font-size: .65rem;
}

.case-timeline p {
    color: var(--muted);
    font-size: .82rem;
    line-height: 1.7;
}

.case-links {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 45px;
    padding-top: 25px;
    border-top: 1px solid var(--border);
}

.case-links a {
    color: var(--accent);
    text-decoration: none;
    font-family: monospace;
    font-size: .75rem;
}


@media (max-width: 900px) {

    .case-two-column,
    .decision-list > div {
        grid-template-columns: 1fr;
        gap: 20px;
    }

    .case-grid-3,
    .case-timeline {
        grid-template-columns: 1fr;
    }

    .case-timeline > div {
        border-right: 0;
        border-bottom: 1px solid var(--border);
    }

    .case-timeline > div:last-child {
        border-bottom: 0;
    }

    .architecture-flow {
        grid-template-columns: 1fr;
    }

    .architecture-flow > b {
        text-align: center;
        transform: rotate(90deg);
    }

}


@media (max-width: 600px) {

    .case-hero {
        padding-top: 85px;
    }

    .workflow-step {
        grid-template-columns: 45px 1fr;
    }

    .evidence-line,
    .evidence-result {
        grid-template-columns: 1fr;
        gap: 6px;
    }

    .case-links {
        flex-direction: column;
    }

}

.project-title-link {
    color: inherit;
    text-decoration: none;
}

.project-title-link:hover {
    color: var(--accent);
}
